#!/bin/bash

# Universal Save/Load Pre-commit Hook
# Security checks to prevent committing sensitive data

# Colors
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

echo -e "${YELLOW}Running security checks...${NC}"

# Counter for issues found
ISSUES=0

# Check for AWS credentials
if git diff --cached --name-only | xargs grep -E "AKIA[A-Z0-9]{16}" 2>/dev/null; then
    echo -e "${RED}❌ ERROR: AWS Access Key detected in commit${NC}"
    echo "   Remove AWS credentials before committing"
    ((ISSUES++))
fi

# Check for AWS Secret Keys
if git diff --cached --name-only | xargs grep -E "aws_secret_access_key|AWS_SECRET_ACCESS_KEY" 2>/dev/null | grep -v "example\|template\|dummy\|test"; then
    echo -e "${RED}❌ ERROR: AWS Secret Key detected in commit${NC}"
    echo "   Remove AWS secrets before committing"
    ((ISSUES++))
fi

# Check for OpenAI API Keys
if git diff --cached --name-only | xargs grep -E "sk-[a-zA-Z0-9]{48}" 2>/dev/null | grep -v "example\|template\|dummy"; then
    echo -e "${RED}❌ ERROR: OpenAI API Key detected in commit${NC}"
    echo "   Remove API keys before committing"
    ((ISSUES++))
fi

# Check for Anthropic API Keys
if git diff --cached --name-only | xargs grep -E "sk-ant-[a-zA-Z0-9]+" 2>/dev/null | grep -v "example\|template\|dummy"; then
    echo -e "${RED}❌ ERROR: Anthropic API Key detected in commit${NC}"
    echo "   Remove API keys before committing"
    ((ISSUES++))
fi

# Check for GitHub tokens
if git diff --cached --name-only | xargs grep -E "ghp_[a-zA-Z0-9]{36}|gho_[a-zA-Z0-9]{36}|github_pat_[a-zA-Z0-9]{22}_[a-zA-Z0-9]{59}" 2>/dev/null; then
    echo -e "${RED}❌ ERROR: GitHub token detected in commit${NC}"
    echo "   Remove GitHub tokens before committing"
    ((ISSUES++))
fi

# Check for Private Keys
if git diff --cached --name-only | xargs grep -E "-----BEGIN (RSA |EC |OPENSSH |DSA |ED25519 )?PRIVATE KEY-----" 2>/dev/null; then
    echo -e "${RED}❌ ERROR: Private key detected in commit${NC}"
    echo "   Remove private keys before committing"
    ((ISSUES++))
fi

# Check for database connection strings
if git diff --cached --name-only | xargs grep -E "mongodb\+srv://|postgres://.*:.*@|mysql://.*:.*@" 2>/dev/null | grep -v "example\|template\|localhost"; then
    echo -e "${RED}❌ ERROR: Database connection string with credentials detected${NC}"
    echo "   Remove database credentials before committing"
    ((ISSUES++))
fi

# Check for JWT secrets
if git diff --cached --name-only | xargs grep -E "JWT_SECRET|SECRET_KEY" 2>/dev/null | grep -v "example\|template\|placeholder"; then
    echo -e "${YELLOW}⚠️  WARNING: Possible secret key detected${NC}"
    echo "   Verify this is not a real secret"
fi

# Check for .env files
if git diff --cached --name-only | grep "^\.env$" 2>/dev/null; then
    echo -e "${RED}❌ ERROR: .env file should not be committed${NC}"
    echo "   Add .env to .gitignore"
    ((ISSUES++))
fi

# If issues were found, block the commit
if [ $ISSUES -gt 0 ]; then
    echo -e "\n${RED}Commit blocked: $ISSUES security issue(s) found${NC}"
    echo -e "Fix the issues above and try again"
    echo -e "To bypass (NOT RECOMMENDED): git commit --no-verify"
    exit 1
else
    echo -e "${GREEN}✅ Security check passed${NC}"
    exit 0
fi