#!/bin/bash

# Universal Save/Load Prepare-commit-msg Hook
# Removes Claude signatures from commit messages

COMMIT_MSG_FILE=$1

# Remove Claude signature lines
sed -i '/🤖 Generated with \[Claude Code\]/d' "$COMMIT_MSG_FILE"
sed -i '/Co-Authored-By: Claude <noreply@anthropic.com>/d' "$COMMIT_MSG_FILE"

# Remove any trailing empty lines
sed -i -e :a -e '/^\s*$/d;N;ba' "$COMMIT_MSG_FILE"

# Optional: Add project identifier to commit messages
# Uncomment the following lines to add a project tag
# PROJECT_NAME=$(basename $(pwd))
# if ! grep -q "\[$PROJECT_NAME\]" "$COMMIT_MSG_FILE"; then
#   sed -i "1s/^/[$PROJECT_NAME] /" "$COMMIT_MSG_FILE"
# fi